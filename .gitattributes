* text=auto eol=lf

# Source and documentation files should stay LF-only.
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.gitignore text eol=lf
LICENSE text eol=lf

# Binary assets should never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.avi binary
*.mov binary
*.mkv binary
*.pt binary
*.pth binary
*.ckpt binary
*.onnx binary
*.npz binary
*.npy binary
*.sqlite binary
*.db binary
